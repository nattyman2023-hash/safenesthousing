generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organisation {
  id                  String                   @id @default(cuid())
  name                String
  slug                String                   @unique
  timezone            String                   @default("Europe/London")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         Membership[]
  users               User[]
  roles               Role[]
  secrets             OrganisationSecret[]
  services            Service[]
  properties          Property[]
  settings            SiteSetting[]
  newsPosts           NewsPost[]
  categories          NewsCategory[]
  referrals           Referral[]
  clients             Client[]
  relatedPeople       RelatedPerson[]
  incidents           Incident[]
  tasks               Task[]
  documents           Document[]
  audits              AuditLog[]
  contactSubmissions  ContactSubmission[]
  retentionRules      DataRetentionRule[]
  subjectRequests     DataSubjectRequest[]
  retentionReviewRuns DataRetentionReviewRun[]
  maintenanceTickets  MaintenanceTicket[]
  appointments        Appointment[]
  concerns            Concern[]
  complaints          Complaint[]
  policyResources     PolicyResource[]
}

model User {
  id                String               @id @default(cuid())
  organisationId    String
  organisation      Organisation         @relation(fields: [organisationId], references: [id])
  email             String               @unique
  name              String
  passwordHash      String
  jobTitle          String?
  active            Boolean              @default(true)
  mfaRequired       Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       Membership[]
  sessions          UserSession[]
  resetTokens       PasswordResetToken[]
  mfaMethods        MfaMethod[]
  mfaRecoveryCodes  MfaRecoveryCode[]
  loginAttempts     LoginAttempt[]
  auditLogs         AuditLog[]
  assignedReferrals ReferralAssignment[] @relation("AssignedReferralUser")
  assignedIncidents Incident[]           @relation("IncidentLead")
  assignedTasks     Task[]               @relation("TaskAssignee")
  keyWorkerClients  Client[]             @relation("ClientKeyWorker")
  supportWorkerClients Client[]          @relation("ClientSupportWorker")
  createdClientRelationships ClientRelationship[] @relation("ClientRelationshipCreator")
}

model Role {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  name           String
  slug           String
  description    String?
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organisationId, slug])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Membership {
  id             String       @id @default(cuid())
  organisationId String
  userId         String
  roleId         String
  serviceIds     String       @default("[]")
  propertyIds    String       @default("[]")
  active         Boolean      @default(true)
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organisationId, userId, roleId])
  @@index([userId])
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  mfaVerifiedAt DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model MfaMethod {
  id                    String    @id @default(cuid())
  userId                String
  type                  String
  secretCipher          String
  verifiedAt            DateTime?
  recoveryCodesIssuedAt DateTime?
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
}

model SiteSetting {
  id             String       @id @default(cuid())
  organisationId String
  key            String
  value          String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, key])
}

model OrganisationSecret {
  id             String       @id @default(cuid())
  organisationId String
  key            String
  secretCipher   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, key])
}

model Service {
  id             String       @id @default(cuid())
  organisationId String
  title          String
  slug           String
  summary        String
  content        String
  audience       String
  referralRoutes String
  eligibility    String
  supportModel   String
  imageUrl       String?
  displayOrder   Int          @default(0)
  published      Boolean      @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  properties     Property[]
  referrals      Referral[]
  clients        Client[]

  @@unique([organisationId, slug])
  @@index([published, displayOrder])
}

model Property {
  id                 String            @id @default(cuid())
  organisationId     String
  serviceId          String?
  publicName         String
  slug               String
  neighbourhood      String
  serviceType        String
  publicSummary      String
  facilities         String            @default("[]")
  eligibility        String
  capacity           Int
  publicVacancyState String
  accessibility      String?
  confidential       Boolean           @default(false)
  secureAddress      String?
  published          Boolean           @default(true)
  displayOrder       Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organisation       Organisation      @relation(fields: [organisationId], references: [id])
  service            Service?          @relation(fields: [serviceId], references: [id])
  images             PropertyImage[]
  rooms              Room[]
  placements         Placement[]
  occupancyRecords   OccupancyRecord[]
  tasks              Task[]
  rotaShifts         RotaShift[]
  maintenanceTickets MaintenanceTicket[]
  appointments       Appointment[]
  concerns           Concern[]
  complianceRecords  PropertyComplianceRecord[]

  @@unique([organisationId, slug])
  @@index([published, publicVacancyState, serviceType])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  storageKey String
  altText    String
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id])
}

model Room {
  id               String            @id @default(cuid())
  propertyId       String
  label            String
  status           String
  notes            String?
  property         Property          @relation(fields: [propertyId], references: [id])
  occupancyRecords OccupancyRecord[]

  @@unique([propertyId, label])
  @@index([status])
}

model NewsCategory {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  slug           String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  posts          NewsPost[]

  @@unique([organisationId, slug])
}

model NewsPost {
  id             String       @id @default(cuid())
  organisationId String
  categoryId     String
  title          String
  slug           String
  summary        String
  content        String
  authorName     String
  featuredImage  String?
  publishedAt    DateTime?
  published      Boolean      @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  category       NewsCategory @relation(fields: [categoryId], references: [id])

  @@unique([organisationId, slug])
  @@index([published, publishedAt])
}

model TeamMember {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  role           String
  bio            String
  imageUrl       String?
  displayOrder   Int     @default(0)
  published      Boolean @default(true)
}

model ContactSubmission {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  email          String
  phone          String?
  category       String
  message        String
  consent        Boolean
  status         String       @default("NEW")
  retentionUntil DateTime?
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([status, createdAt])
}

model Referral {
  id                     String                  @id @default(cuid())
  organisationId         String
  serviceId              String
  reference              String                  @unique
  status                 String                  @default("NEW")
  referrerName           String
  referrerOrganisation   String?
  referrerRole           String?
  referrerEmail          String
  referrerPhone          String?
  relationship           String?
  personName             String
  personIdentifier       String?
  ageRange               String?
  pronouns               String?
  contactDetails         String?
  currentLocation        String?
  housingSituation       String
  supportNeeds           String
  knownRisks             String?
  accessibilityNeeds     String?
  fundingRoute           String?
  consentGiven           Boolean
  privacyAcknowledged    Boolean
  anonymousDomesticAbuse Boolean                 @default(false)
  honeypot               String?
  followUpDate           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organisation           Organisation            @relation(fields: [organisationId], references: [id])
  service                Service                 @relation(fields: [serviceId], references: [id])
  statusHistory          ReferralStatusHistory[]
  assignments            ReferralAssignment[]
  notes                  ReferralNote[]
  risks                  ReferralRisk[]
  documents              ReferralDocument[]
  client                 Client?

  @@index([organisationId, status, createdAt])
  @@index([serviceId, status])
}

model ReferralStatusHistory {
  id         String   @id @default(cuid())
  referralId String
  previous   String?
  next       String
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now())
  referral   Referral @relation(fields: [referralId], references: [id])

  @@index([referralId, createdAt])
}

model ReferralAssignment {
  id         String   @id @default(cuid())
  referralId String
  userId     String
  assignedAt DateTime @default(now())
  referral   Referral @relation(fields: [referralId], references: [id])
  user       User     @relation("AssignedReferralUser", fields: [userId], references: [id])
}

model ReferralNote {
  id         String   @id @default(cuid())
  referralId String
  authorId   String
  note       String
  restricted Boolean  @default(false)
  createdAt  DateTime @default(now())
  referral   Referral @relation(fields: [referralId], references: [id])
}

model ReferralRisk {
  id         String   @id @default(cuid())
  referralId String
  category   String
  level      String
  summary    String
  restricted Boolean  @default(true)
  createdAt  DateTime @default(now())
  referral   Referral @relation(fields: [referralId], references: [id])
}

model ReferralDocument {
  id         String   @id @default(cuid())
  referralId String
  documentId String
  referral   Referral @relation(fields: [referralId], references: [id])
  document   Document @relation(fields: [documentId], references: [id])
}

model Client {
  id                 String                @id @default(cuid())
  organisationId     String
  serviceId          String?
  referralId         String?               @unique
  reference          String                @unique
  displayName        String
  dateOfBirth        DateTime?
  keyWorkerId        String?
  supportWorkerId    String?
  phone              String?
  email              String?
  address            String?
  gender             String?
  pronouns           String?
  admissionDate      DateTime?
  dischargeDate      DateTime?
  moveInTargetDate   DateTime?
  referralSource     String?
  contactFrequencyDays Int                @default(7)
  safeWellFrequencyDays Int               @default(30)
  riskLevel          String                @default("Medium")
  communicationNeeds String?
  importantAlerts    String?
  safeguardingFlag   Boolean               @default(false)
  restricted         Boolean               @default(false)
  status             String                @default("CURRENT")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organisation       Organisation          @relation(fields: [organisationId], references: [id])
  service            Service?              @relation(fields: [serviceId], references: [id])
  referral           Referral?             @relation(fields: [referralId], references: [id])
  keyWorker          User?                 @relation("ClientKeyWorker", fields: [keyWorkerId], references: [id])
  supportWorker      User?                 @relation("ClientSupportWorker", fields: [supportWorkerId], references: [id])
  placements         Placement[]
  occupancyRecords   OccupancyRecord[]
  supportPlans       SupportPlan[]
  caseNotes          CaseNote[]
  incidents          Incident[]
  tasks              Task[]
  housingBenefit     HousingBenefitClaim[]
  documents          Document[]
  relationshipsFrom  ClientRelationship[]  @relation("ClientRelationships")
  relationshipsTo    ClientRelationship[]  @relation("RelatedClientRelationships")
  penPortrait        PenPortrait?
  riskAssessments    RiskAssessment[]
  safeWellChecks     SafeWellCheck[]
  moveChecklists     MoveChecklist[]
  maintenanceTickets MaintenanceTicket[]
  appointments       Appointment[]
  concerns           Concern[]
  complaints         Complaint[]
  invoices           Invoice[]

  @@index([organisationId, status])
  @@index([displayName])
  @@index([organisationId, keyWorkerId])
  @@index([organisationId, supportWorkerId])
}

model Placement {
  id               String            @id @default(cuid())
  clientId         String
  propertyId       String
  roomId           String
  status           String            @default("ACTIVE")
  startDate        DateTime
  endDate          DateTime?
  tenancyRef       String?
  endedReason      String?
  client           Client            @relation(fields: [clientId], references: [id])
  property         Property          @relation(fields: [propertyId], references: [id])
  occupancyRecords OccupancyRecord[]

  @@index([propertyId, roomId, status])
}

model OccupancyRecord {
  id          String    @id @default(cuid())
  propertyId  String
  roomId      String
  clientId    String
  placementId String
  startDate   DateTime
  endDate     DateTime?
  property    Property  @relation(fields: [propertyId], references: [id])
  room        Room      @relation(fields: [roomId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
  placement   Placement @relation(fields: [placementId], references: [id])

  @@index([roomId, startDate, endDate])
}

model SupportPlan {
  id         String              @id @default(cuid())
  clientId   String
  version    Int                 @default(1)
  status     String              @default("ACTIVE")
  reviewDate DateTime?
  createdBy  String
  createdAt  DateTime            @default(now())
  client     Client              @relation(fields: [clientId], references: [id])
  goals      SupportGoal[]
  reviews    SupportPlanReview[]

  @@index([clientId, status])
}

model SupportGoal {
  id             String      @id @default(cuid())
  supportPlanId  String
  category       String
  desiredOutcome String
  actionSteps    String
  owner          String?
  targetDate     DateTime?
  status         String      @default("NOT_STARTED")
  supportPlan    SupportPlan @relation(fields: [supportPlanId], references: [id])
}

model SupportPlanReview {
  id            String      @id @default(cuid())
  supportPlanId String
  reviewDate    DateTime
  notes         String
  reviewedBy    String
  supportPlan   SupportPlan @relation(fields: [supportPlanId], references: [id])
}

model CaseNote {
  id             String            @id @default(cuid())
  clientId       String
  authorId       String
  contactType    String
  category       String
  note           String
  outcome        String?
  followUpAction String?
  followUpDate   DateTime?
  occurredAt     DateTime          @default(now())
  method         String            @default("OTHER")
  direction      String?           @default("OUTBOUND")
  durationMinutes Int?
  completed      Boolean           @default(true)
  attempted      Boolean           @default(false)
  meaningful     Boolean           @default(true)
  nextContactDueAt DateTime?
  restricted     Boolean           @default(false)
  finalised      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  client         Client            @relation(fields: [clientId], references: [id])
  versions       CaseNoteVersion[]

  @@index([clientId, createdAt])
  @@index([clientId, occurredAt])
  @@index([clientId, meaningful, completed])
}

model CaseNoteVersion {
  id         String   @id @default(cuid())
  caseNoteId String
  authorId   String
  content    String
  reason     String?
  createdAt  DateTime @default(now())
  caseNote   CaseNote @relation(fields: [caseNoteId], references: [id])
}

model Incident {
  id              String           @id @default(cuid())
  organisationId  String
  clientId        String?
  reference       String           @unique
  category        String
  severity        String
  status          String           @default("OPEN")
  incidentAt      DateTime
  location        String?
  description     String
  immediateAction String?
  assignedLeadId  String?
  restricted      Boolean          @default(true)
  closureDecision String?
  reviewDate      DateTime?
  createdAt       DateTime         @default(now())
  organisation    Organisation     @relation(fields: [organisationId], references: [id])
  client          Client?          @relation(fields: [clientId], references: [id])
  assignedLead    User?            @relation("IncidentLead", fields: [assignedLeadId], references: [id])
  updates         IncidentUpdate[]
  actions         IncidentAction[]

  @@index([organisationId, status, severity])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  update     String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
}

model IncidentAction {
  id          String    @id @default(cuid())
  incidentId  String
  action      String
  owner       String?
  dueDate     DateTime?
  completedAt DateTime?
  incident    Incident  @relation(fields: [incidentId], references: [id])
}

model RestrictedAccessAssignment {
  id           String    @id @default(cuid())
  userId       String
  resourceType String
  resourceId   String
  reason       String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, resourceType, resourceId])
}

model Task {
  id             String       @id @default(cuid())
  organisationId String
  title          String
  description    String?
  priority       String       @default("MEDIUM")
  dueAt          DateTime?
  status         String       @default("OPEN")
  assignedToId   String?
  clientId       String?
  propertyId     String?
  referralId     String?
  incidentId     String?
  department     String       @default("SUPPORT")
  category       String       @default("GENERAL")
  source         String       @default("MANUAL")
  automationKey  String?
  recurrenceRule String?
  recurrenceIntervalDays Int?
  relatedType    String?
  relatedId      String?
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  property       Property?    @relation(fields: [propertyId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id])

  @@unique([organisationId, automationKey])
  @@index([organisationId, status, dueAt])
  @@index([organisationId, department, status])
  @@index([organisationId, assignedToId, status])
  @@index([clientId, status])
}

model RotaShift {
  id             String           @id @default(cuid())
  organisationId String
  propertyId     String?
  serviceId      String?
  shiftType      String
  startsAt       DateTime
  endsAt         DateTime
  handover       String?
  overrideReason String?
  property       Property?        @relation(fields: [propertyId], references: [id])
  assignments    RotaAssignment[]

  @@index([startsAt, endsAt])
}

model RotaAssignment {
  id      String    @id @default(cuid())
  shiftId String
  userId  String
  shift   RotaShift @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, userId])
}

model FundingSource {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model HousingBenefitClaim {
  id                 String    @id @default(cuid())
  clientId           String
  status             String    @default("NOT_STARTED")
  submittedAt        DateTime?
  evidenceRequired   String?
  weeklyRentMinor    Int       @default(0)
  serviceChargeMinor Int       @default(0)
  paymentStatus      String    @default("PENDING")
  client             Client    @relation(fields: [clientId], references: [id])

  @@index([status, paymentStatus])
}

model Invoice {
  id             String        @id @default(cuid())
  organisationId String
  clientId       String?
  reference      String        @unique
  status         String        @default("DRAFT")
  totalMinor     Int           @default(0)
  periodStart    DateTime?
  periodEnd      DateTime?
  issuedAt       DateTime?
  dueAt          DateTime?
  client         Client?       @relation(fields: [clientId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@index([organisationId, status, dueAt])
  @@index([clientId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitMinor   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  amountMinor Int
  paidAt      DateTime
  method      String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model Document {
  id                String             @id @default(cuid())
  organisationId    String
  clientId          String?
  displayName       String
  storageKey        String             @unique
  mimeType          String
  sizeBytes         Int
  sha256            String?
  malwareScanStatus String             @default("SKIPPED")
  malwareScannedAt  DateTime?
  category          String
  // What the document is, in the words of the person who filed it. Optional so existing files
  // keep working; free text and never a place for confidential narrative.
  description       String?
  // The date on the document itself, which can differ from the upload date.
  documentDate      DateTime?
  restricted        Boolean            @default(false)
  expiresAt         DateTime?
  reviewDate        DateTime?
  uploadedBy        String
  createdAt         DateTime           @default(now())
  organisation      Organisation       @relation(fields: [organisationId], references: [id])
  client            Client?            @relation(fields: [clientId], references: [id])
  versions          DocumentVersion[]
  referralLinks     ReferralDocument[]

  @@index([organisationId, category, restricted])
  @@index([organisationId, clientId, createdAt])
}

model RelatedPerson {
  id                    String                @id @default(cuid())
  organisationId        String
  fullName              String
  phone                 String?
  email                 String?
  address               String?
  notes                 String?
  preferredContactMethod String?
  consentToContact      Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organisation          Organisation          @relation(fields: [organisationId], references: [id])
  relationships         ClientRelationship[]

  @@index([organisationId, fullName])
}

model ClientRelationship {
  id                      String         @id @default(cuid())
  clientId                String
  relatedClientId         String?
  relatedPersonId         String?
  relationshipType        String
  inverseRelationshipType String?
  startDate               DateTime?
  endDate                 DateTime?
  notes                   String?
  isEmergencyContact      Boolean        @default(false)
  isNextOfKin             Boolean        @default(false)
  createdBy               String
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  client                  Client         @relation("ClientRelationships", fields: [clientId], references: [id])
  relatedClient           Client?        @relation("RelatedClientRelationships", fields: [relatedClientId], references: [id])
  relatedPerson           RelatedPerson? @relation(fields: [relatedPersonId], references: [id])
  creator                 User           @relation("ClientRelationshipCreator", fields: [createdBy], references: [id])

  @@index([clientId, endDate])
  @@index([relatedClientId, endDate])
  @@index([relatedPersonId, endDate])
  @@unique([clientId, relatedClientId, relationshipType])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  storageKey String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  beforeJson     String?
  afterJson      String?
  success        Boolean      @default(true)
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organisationId, resourceType, createdAt])
  @@index([actorId, createdAt])
}

model DataRetentionRule {
  id             String       @id @default(cuid())
  organisationId String
  resourceType   String
  retentionDays  Int
  legalBasisNote String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, resourceType])
  @@index([organisationId, active])
}

model DataSubjectRequest {
  id             String       @id @default(cuid())
  organisationId String
  requestType    String
  subjectRef     String
  status         String       @default("OPEN")
  dueAt          DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  legalHold      Boolean      @default(false)
  reviewedBy     String?
  reviewedAt     DateTime?
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, status, dueAt])
}

model DataRetentionReviewRun {
  id             String       @id @default(cuid())
  organisationId String
  triggeredBy    String?
  mode           String       @default("DRY_RUN")
  status         String       @default("COMPLETED")
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  summaryJson    String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, startedAt])
}

// ---------------------------------------------------------------------------
// Support & Risk module — PEN Portraits, risk assessment, Safe & Well, moves.
// ---------------------------------------------------------------------------

/// One PEN Portrait per service user. Status drives the dashboard prompt.
model PenPortrait {
  id              String    @id @default(cuid())
  clientId        String    @unique
  status          String    @default("NOT_STARTED")
  aboutMe         String?
  myNeeds         String?
  howIShow        String?
  whatMatters     String?
  myStrengths     String?
  communication   String?
  likes           String?
  dislikes        String?
  healthNeeds     String?
  risksToMe       String?
  whoSupportsMe   String?
  completedAt     DateTime?
  reviewDueAt     DateTime?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id])

  @@index([status, reviewDueAt])
}

/// A formal risk assessment owned by a service user.
model RiskAssessment {
  id              String       @id @default(cuid())
  clientId        String
  assessmentType  String       @default("SUPPORT")
  level           String       @default("MEDIUM")
  status          String       @default("DRAFT")
  assessedAt      DateTime     @default(now())
  reviewDueAt     DateTime?
  assessedBy      String?
  summary         String?
  controlMeasures String?
  triggerReason   String?
  supersedesId    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  client          Client       @relation(fields: [clientId], references: [id])
  factors         RiskFactor[]

  @@index([clientId, status])
  @@index([status, reviewDueAt])
  @@index([level, status])
}

/// An individual scored risk factor inside an assessment.
model RiskFactor {
  id               String         @id @default(cuid())
  riskAssessmentId String
  category         String
  description      String
  likelihood       Int            @default(3)
  impact           Int            @default(3)
  score            Int            @default(9)
  controlMeasures  String?
  status           String         @default("OPEN")
  createdAt        DateTime       @default(now())
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  @@index([riskAssessmentId, score])
}

/// A Safe & Well check. Frequency comes from the service user's profile.
model SafeWellCheck {
  id             String    @id @default(cuid())
  clientId       String
  status         String    @default("SCHEDULED")
  scheduledFor   DateTime?
  completedAt    DateTime?
  checkedById    String?
  method         String    @default("IN_PERSON")
  concernRaised  Boolean   @default(false)
  concernSummary String?
  actionsTaken   String?
  nextDueAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  client         Client    @relation(fields: [clientId], references: [id])

  @@index([clientId, status])
  @@index([status, nextDueAt])
}

/// Move-in or move-out checklist for a service user.
model MoveChecklist {
  id           String              @id @default(cuid())
  clientId     String
  checklistType String             @default("MOVE_IN")
  status       String              @default("NOT_STARTED")
  targetDate   DateTime?
  completedAt  DateTime?
  propertyId   String?
  placementId  String?
  createdBy    String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  client       Client              @relation(fields: [clientId], references: [id])
  items        MoveChecklistItem[]

  @@index([clientId, checklistType, status])
  @@index([status, targetDate])
}

/// A single tracked step inside a move checklist.
model MoveChecklistItem {
  id           String        @id @default(cuid())
  checklistId  String
  label        String
  category     String        @default("OTHER")
  status       String        @default("PENDING")
  ownerId      String?
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  checklist    MoveChecklist @relation(fields: [checklistId], references: [id])

  @@index([checklistId, sortOrder])
  @@index([status, dueAt])
}


// ---------------------------------------------------------------------------
// Operations module — maintenance, appointments, concerns, complaints.
// ---------------------------------------------------------------------------

/// A repair or facilities job, optionally raised on behalf of a service user.
model MaintenanceTicket {
  id             String              @id @default(cuid())
  organisationId String
  reference      String              @unique
  clientId       String?
  propertyId     String?
  roomId         String?
  title          String
  description    String?
  category       String              @default("GENERAL")
  trade          String              @default("GENERAL")
  priority       String              @default("MEDIUM")
  status         String              @default("REPORTED")
  safetyRisk     Boolean             @default(false)
  reportedById   String?
  assignedToId   String?
  contractor     String?
  reportedAt     DateTime            @default(now())
  targetFixAt    DateTime?
  completedAt    DateTime?
  costMinor      Int?
  organisation   Organisation        @relation(fields: [organisationId], references: [id])
  client         Client?             @relation(fields: [clientId], references: [id])
  property       Property?           @relation(fields: [propertyId], references: [id])
  updates        MaintenanceUpdate[]
  appointments   Appointment[]

  @@index([organisationId, status, priority])
  @@index([organisationId, propertyId, status])
  @@index([clientId, status])
  @@index([status, targetFixAt])
}

/// Progress note against a maintenance ticket.
model MaintenanceUpdate {
  id        String            @id @default(cuid())
  ticketId  String
  status    String?
  note      String
  authorId  String?
  createdAt DateTime          @default(now())
  ticket    MaintenanceTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}

/// A scheduled appointment for a service user, contractor visit, or review.
model Appointment {
  id             String             @id @default(cuid())
  organisationId String
  clientId       String?
  propertyId     String?
  ticketId       String?
  title          String
  category       String             @default("SUPPORT")
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  allDay         Boolean            @default(false)
  status         String             @default("SCHEDULED")
  ownerId        String?
  attendees      String?
  notes          String?
  completedAt    DateTime?
  outcome        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organisation   Organisation       @relation(fields: [organisationId], references: [id])
  client         Client?            @relation(fields: [clientId], references: [id])
  property       Property?          @relation(fields: [propertyId], references: [id])
  ticket         MaintenanceTicket? @relation(fields: [ticketId], references: [id])

  @@index([organisationId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
}


/// A concern or welfare worry raised about a service user.
model Concern {
  id             String          @id @default(cuid())
  organisationId String
  reference      String          @unique
  clientId       String?
  propertyId     String?
  title          String
  summary        String
  category       String          @default("WELFARE")
  severity       String          @default("MEDIUM")
  status         String          @default("OPEN")
  raisedById     String?
  ownerId        String?
  raisedAt       DateTime        @default(now())
  dueAt          DateTime?
  resolvedAt     DateTime?
  resolution     String?
  referralNeeded Boolean         @default(false)
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  property       Property?       @relation(fields: [propertyId], references: [id])
  actions        ConcernAction[]

  @@index([organisationId, status, severity])
  @@index([clientId, status])
  @@index([status, dueAt])
}

/// Action taken to resolve a concern.
model ConcernAction {
  id        String   @id @default(cuid())
  concernId String
  note      String
  authorId  String?
  createdAt DateTime @default(now())
  concern   Concern  @relation(fields: [concernId], references: [id])

  @@index([concernId, createdAt])
}

/// A formal complaint, including service-user and external complaints.
model Complaint {
  id              String       @id @default(cuid())
  organisationId  String
  reference       String       @unique
  clientId        String?
  raisedBy        String       @default("SERVICE_USER")
  complainantName String?
  title           String
  summary         String
  category        String       @default("SERVICE")
  severity        String       @default("MEDIUM")
  status          String       @default("LOGGED")
  stage           String       @default("STAGE_1")
  ownerId         String?
  receivedAt      DateTime     @default(now())
  acknowledgedAt  DateTime?
  dueAt           DateTime?
  closedAt        DateTime?
  outcome         String?
  learning        String?
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  client          Client?      @relation(fields: [clientId], references: [id])

  @@index([organisationId, status, dueAt])
  @@index([clientId, status])
}

/// Recurring compliance obligation for a property (gas, electric, legionella...).
model PropertyComplianceRecord {
  id             String   @id @default(cuid())
  propertyId     String
  complianceType String
  status         String   @default("DUE")
  lastCheckedAt  DateTime?
  nextDueAt      DateTime?
  certificateRef String?
  contractor     String?
  outcome        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  property       Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, complianceType])
  @@index([status, nextDueAt])
}

/// A policy, procedure, or resource document surfaced in the CRM.
model PolicyResource {
  id             String       @id @default(cuid())
  organisationId String
  title          String
  category       String       @default("POLICY")
  summary        String?
  version        String?
  documentId     String?
  externalUrl    String?
  status         String       @default("ACTIVE")
  ownerId        String?
  effectiveFrom  DateTime?
  reviewDueAt    DateTime?
  requiresRead   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, category, status])
  @@index([status, reviewDueAt])
}

