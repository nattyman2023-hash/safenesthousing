# Safe Nest - production environment template.
# Copy to .env on the server (or import through Hostinger hPanel), then replace every placeholder.
# Never commit real secrets.

NODE_ENV=production
APP_URL=https://<your-domain>
ORGANISATION_TIMEZONE=Europe/London
NEXT_PUBLIC_SITE_NAME=Safe Nest Housing & Support

# Persistent production database outside the public web root.
DATABASE_URL=file:/home/<user>/domains/<your-domain>/app/data/prod.db

# Strong secrets (>= 32 random characters each). Generate with: openssl rand -hex 32
AUTH_SECRET=<64 random hex chars>
FILE_SIGNING_SECRET=<64 random hex chars>
RETENTION_REVIEW_SECRET=<64 random hex chars>

# Email (Emailit or SMTP). Configure the real provider before go-live.
EMAIL_FROM=Safe Nest <hello@safenesthousing.co.uk>
EMAIL_PROVIDER=emailit
EMAILIT_API_URL=https://api.emailit.com/v2/emails
# EMAILIT_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Private document storage outside the public web root.
STORAGE_PROVIDER=local
PRIVATE_STORAGE_PATH=/home/<user>/domains/<your-domain>/app/storage/private
# STORAGE_PROVIDER=s3
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=
# STORAGE_FORCE_PATH_STYLE=false

# Rate limiting: memory for one instance; use http plus URL/token for multiple instances.
RATE_LIMIT_PROVIDER=memory
# RATE_LIMIT_URL=
# RATE_LIMIT_TOKEN=

# Malware scanning for document uploads.
# Production fails closed: with REQUIRE_MALWARE_SCAN=true an upload is refused unless the scanner
# returns an explicit clean verdict, and only documents whose stored status is CLEAN can be
# downloaded. Supported providers:
#   cloudmersive  fixed endpoint https://api.cloudmersive.com/virus/scan/file; requires CLOUDMERSIVE_API_KEY
#   http          your own scanner at MALWARE_SCAN_URL; requires MALWARE_SCAN_TOKEN
#   disabled      no scanner contacted; uploads are refused while REQUIRE_MALWARE_SCAN=true
# Keep credentials in the server environment only. Readiness fails until a real credential is set.
MALWARE_SCAN_PROVIDER=cloudmersive
CLOUDMERSIVE_API_KEY=<cloudmersive-api-key>
# MALWARE_SCAN_PROVIDER=http
# MALWARE_SCAN_URL=https://<your-scanner-host>/scan
# MALWARE_SCAN_TOKEN=<scanner-shared-secret>
REQUIRE_MALWARE_SCAN=true

# Complete the security and operations review before handling real data.
# FRESH INSTALLATIONS ONLY: `npm run bootstrap:admin` creates the first organisation/administrator for
# a completely new SafeNest installation. DO NOT run it when upgrading an existing populated
# installation — existing organisations, administrator accounts and authentication records must be
# preserved.
# Never run `npm run db:seed` in production, and never re-import this template over a live .env: the
# paths above are placeholders, and a new database path makes the migration script create a new, empty
# database instead of upgrading the existing one.
