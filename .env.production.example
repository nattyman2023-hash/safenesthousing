# ─────────────────────────────────────────────────────────────────────────────
# Safe Nest — production environment template.
# Copy to .env on the server (or import via Hostinger hPanel "Import .env"),
# then replace every <...> placeholder. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
APP_URL=https://<your-domain>
ORGANISATION_TIMEZONE=Europe/London
NEXT_PUBLIC_SITE_NAME=Safe Nest Housing & Support

# Persistent production database (absolute path OUTSIDE the public web root).
# Single-instance SQLite is fine; for scale use PostgreSQL (change the Prisma
# provider and generate a PostgreSQL migration first — never point SQLite SQL at PostgreSQL).
DATABASE_URL=file:/home/<user>/domains/<your-domain>/app/data/prod.db

# Strong secrets (>= 32 random characters each). Generate with: openssl rand -hex 32
AUTH_SECRET=<64 random hex chars>
FILE_SIGNING_SECRET=<64 random hex chars>
RETENTION_REVIEW_SECRET=<64 random hex chars>

# Email (Emailit or SMTP). An unconfigured provider degrades to a logged no-op so forms still
# complete; configure the real key/provider before go-live.
EMAIL_FROM=Safe Nest <hello@safenesthousing.co.uk>
EMAIL_PROVIDER=emailit
EMAILIT_API_URL=https://api.emailit.com/v2/emails
# EMAILIT_API_KEY=                      # add the real key at go-live
# SMTP_HOST=                            # or use SMTP instead of Emailit
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Private document storage (local filesystem outside the public web root).
STORAGE_PROVIDER=local
PRIVATE_STORAGE_PATH=/home/<user>/domains/<your-domain>/app/storage/private
# For S3-compatible storage instead of local:
# STORAGE_PROVIDER=s3
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=
# STORAGE_FORCE_PATH_STYLE=false

# Rate limiting. Use "memory" for a single instance; "http" + URL/token for >1 instance.
RATE_LIMIT_PROVIDER=memory
# RATE_LIMIT_URL=
# RATE_LIMIT_TOKEN=

# Malware scanning for document uploads. "disabled" lets uploads through (assessment build);
# set "http" + an authenticated scanner before handling real documents.
MALWARE_SCAN_PROVIDER=disabled
# MALWARE_SCAN_URL=
# MALWARE_SCAN_TOKEN=
# REQUIRE_MALWARE_SCAN=

# MFA and presentation-mode flags are obsolete (removed from the active flow). Before real
# go-live, design and re-introduce MFA + RBAC + a real email/malware/backups stack, then create
# the first administrator with `npm run bootstrap:admin` (never `npm run db:seed` in production).
