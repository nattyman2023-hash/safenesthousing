# Local default: file:./dev.db. Production should use a persistent database URL.
APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
AUTH_SECRET=replace-with-at-least-32-random-characters
EMAIL_FROM=Safe Nest <admin@safenesthousing.org.uk>
EMAIL_PROVIDER=emailit
# Supply this through the deployment secret store; never commit the actual key.
EMAILIT_API_KEY=
EMAILIT_API_URL=https://api.emailit.com/v2/emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
STORAGE_ENDPOINT=
STORAGE_PROVIDER=local
STORAGE_FORCE_PATH_STYLE=false
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
FILE_SIGNING_SECRET=replace-with-another-long-random-secret
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SITE_NAME=Safe Nest Housing & Support
ORGANISATION_TIMEZONE=Europe/London
PRIVATE_STORAGE_PATH=storage/private
MALWARE_SCAN_PROVIDER=disabled
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
REQUIRE_MALWARE_SCAN=false
RETENTION_REVIEW_SECRET=replace-with-a-long-random-scheduler-secret
# MFA, RBAC permission gates, and presentation-mode bypasses have been removed from the active
# application flow. Authenticated users have unrestricted CRM access. Do not re-introduce MFA,
# ENABLE_DEV_AUTH_BYPASS, MFA_ENABLED, DISABLE_MFA_FOR_DEV or SAFE_NEST_PRESENTATION_MODE without a
# corresponding redesign — see docs/go-live-runbook.md.
